# Docker Compose and local development settings
DATABASE_URL=postgres://pupsj_rms:pupsj_rms_local@localhost:5433/pupsj_rms
POSTGRES_DB=pupsj_rms
POSTGRES_USER=pupsj_rms
POSTGRES_PASSWORD=pupsj_rms_local
APP_PORT=3000

# Replace this with a private random value before using the app.
JWT_SECRET=replace_with_a_long_random_value
DEFAULT_STAFF_PASSWORD=replace_with_a_private_password
LOCAL_DATA_DIR=.local

# Required for production startup and scanner hot-folder authentication.
HOT_FOLDER_INGEST_TOKEN=replace_with_a_random_token_at_least_32_chars
HOT_FOLDER_SOURCE_STATION=Docker-Scanner
HOT_FOLDER_OFFICE_ID=registrar
HOT_FOLDER_HOST_PATH=/tmp/pupsj-rms-hot-folder
